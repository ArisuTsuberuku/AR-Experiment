:root {
  --nen: #0E1116;
  --nen-the: #171C24;
  --vien: rgba(255, 255, 255, 0.12);
  --chu: #F2F4F7;
  --chu-phu: #9AA4B2;
  --nhan: #F5A524;
  --chu-tren-nhan: #1A1204;
  --xanh: #4CC3FF;
  --kinh: rgba(14, 17, 22, 0.72);
}

.goc {
  flex-grow: 1;
}

.man {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.an {
  display: none;
}

.unity-button {
  -unity-text-align: middle-center;
  border-width: 0;
  margin: 0;
  padding: 0;
  background-color: rgba(0, 0, 0, 0);
  color: var(--chu);
}

.unity-label {
  margin: 0;
  padding: 0;
}

/* ------------------------------------------------ Thư viện */
.man-thu-vien {
  background-color: var(--nen);
}

.cuon {
  flex-grow: 1;
}

.cuon .unity-scroll-view__content-container {
  padding: 40px 20px 24px 20px;
}

.nhan-phu {
  color: var(--chu-phu);
  font-size: 13px;
}

.tieu-de {
  font-size: 28px;
  -unity-font-style: bold;
  margin: 2px 0 16px 0;
}

.o-tim {
  margin: 0 0 14px 0;
}

.o-tim > .unity-base-text-field__input {
  height: 46px;
  padding: 0 16px;
  border-radius: 14px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--nen-the);
  color: var(--chu);
  -unity-text-align: middle-left;
  --unity-cursor-color: var(--nhan);
  --unity-selection-color: rgba(245, 165, 36, 0.35);
}

.o-tim .unity-base-text-field__input--placeholder {
  color: var(--chu-phu);
}

.dong-chip {
  flex-direction: row;
  margin-bottom: 18px;
}

.chip {
  height: 36px;
  padding: 0 16px;
  margin-right: 8px;
  border-radius: 18px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--nen-the);
  color: var(--chu-phu);
}

.chip--chon {
  background-color: var(--nhan);
  border-color: var(--nhan);
  color: var(--chu-tren-nhan);
  -unity-font-style: bold;
}

.trang-thai {
  color: var(--chu-phu);
  white-space: normal;
  margin-bottom: 12px;
}

.the {
  border-radius: 20px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.08);
  background-color: var(--nen-the);
  padding: 0 0 14px 0;
  align-items: stretch;
  overflow: hidden;
  -unity-text-align: upper-left;
}

.the:active {
  background-color: #1E2530;
}

.the--lon {
  margin-bottom: 12px;
}

.the--nho {
  flex-grow: 1;
  flex-basis: 0;
}

.the--dem {
  flex-grow: 1;
  flex-basis: 0;
}

.luoi {
  flex-direction: row;
  margin-bottom: 12px;
}

.luoi > .the--nho {
  margin-right: 12px;
}

.anh-the {
  height: 120px;
  margin-bottom: 12px;
  background-color: #222A35;
  -unity-background-scale-mode: scale-and-crop;
  align-items: flex-start;
  padding: 10px;
}

.the--lon > .anh-the {
  height: 200px;
}

.ten-the {
  margin: 0 14px;
  white-space: normal;
  -unity-font-style: bold;
  font-size: 15px;
}

.the--lon > .ten-the {
  font-size: 19px;
}

.phu-the {
  margin: 4px 14px 0 14px;
  color: var(--chu-phu);
  font-size: 12px;
}

.nhan-sap-co,
.nhan-nhap {
  padding: 3px 10px;
  border-radius: 10px;
  font-size: 11px;
  background-color: var(--kinh);
  color: var(--chu-phu);
}

.nhan-nhap {
  color: var(--nhan);
}

.the--sap-co {
  opacity: 0.55;
}

.thanh-duoi {
  flex-direction: row;
  height: 64px;
  border-top-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
}

.tab-duoi {
  flex-grow: 1;
  flex-basis: 0;
  -unity-text-align: middle-center;
  color: var(--chu-phu);
  font-size: 13px;
}

.tab-duoi--chon {
  color: var(--nhan);
  -unity-font-style: bold;
}

/* ------------------------------------------------ Chi tiết 3D */
.khung-3d {
  height: 400px;
  padding: 36px 16px 12px 16px;
  justify-content: space-between;
}

.hang-tren {
  flex-direction: row;
  align-items: center;
}

.nut-tron {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
  font-size: 26px;
  -unity-text-align: middle-center;
  margin-right: 10px;
}

.chip-trang-thai {
  padding: 6px 12px;
  border-radius: 14px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
  color: var(--xanh);
  font-size: 12px;
}

.dang-nap {
  align-self: center;
  margin-bottom: 150px;
  color: var(--chu-phu);
  white-space: normal;
  -unity-text-align: middle-center;
}

.bang-chi-tiet {
  flex-grow: 1;
  padding: 20px 20px 24px 20px;
  border-top-left-radius: 28px;
  border-top-right-radius: 28px;
  border-top-width: 1px;
  border-color: var(--vien);
  background-color: var(--nen);
}

.tieu-de-nho {
  font-size: 21px;
  -unity-font-style: bold;
  white-space: normal;
  margin-bottom: 6px;
}

.dong-tab {
  flex-direction: row;
  margin: 14px 0 6px 0;
  border-bottom-width: 1px;
  border-color: var(--vien);
}

.tab {
  height: 44px;
  padding: 0 14px;
  border-bottom-width: 2px;
  border-color: rgba(0, 0, 0, 0);
  color: var(--chu-phu);
}

.tab--chon {
  border-color: var(--nhan);
  color: var(--chu);
  -unity-font-style: bold;
}

.noi-dung-tab {
  flex-grow: 1;
  margin-bottom: 12px;
}

.dong-bo-phan {
  flex-direction: row;
  align-items: center;
  height: 44px;
  border-bottom-width: 1px;
  border-color: rgba(255, 255, 255, 0.06);
}

.cham {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 12px;
}

.cham--1 { background-color: #F5A524; }
.cham--2 { background-color: #4CC3FF; }
.cham--3 { background-color: #8BD17C; }
.cham--4 { background-color: #F07CA8; }
.cham--5 { background-color: #B69CFF; }

.dong-thong-so {
  padding: 10px 0;
  border-bottom-width: 1px;
  border-color: rgba(255, 255, 255, 0.06);
}

.ten-thong-so {
  color: var(--chu-phu);
  font-size: 12px;
  margin-bottom: 2px;
}

.gia-tri-thong-so {
  white-space: normal;
}

.nut-chinh {
  height: 54px;
  border-radius: 16px;
  background-color: var(--nhan);
  color: var(--chu-tren-nhan);
  font-size: 16px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.nut-chinh:active {
  background-color: #D98F14;
}

.nut-chinh:disabled {
  opacity: 0.45;
}

/* ------------------------------------------------ AR */
.man-ar {
  padding: 36px 16px 24px 16px;
  justify-content: space-between;
}

.the-huong-dan,
.the-tam-dung {
  padding: 18px;
  border-radius: 24px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
}

.chu-huong-dan {
  white-space: normal;
  color: var(--chu);
  margin-bottom: 14px;
}

.vung-cham,
.lop-nhan {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.man-ar.an-khi-chup {
  visibility: hidden;
}

.cum-duoi {
  justify-content: flex-end;
}

.nhan-bo-phan {
  position: absolute;
  padding: 4px 10px;
  border-radius: 12px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
  font-size: 12px;
}

.bang-duoi {
  padding: 14px 16px;
  margin-bottom: 10px;
  border-radius: 20px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
}

.hang-bang {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.tieu-de-bang {
  flex-grow: 1;
  flex-shrink: 1;
  white-space: normal;
  -unity-font-style: bold;
  font-size: 16px;
}

.nut-dong-bang {
  width: 44px;
  height: 44px;
  font-size: 22px;
}

.thanh-cong-cu {
  flex-direction: row;
  padding: 6px;
  border-radius: 24px;
  border-width: 1px;
  border-color: var(--vien);
  background-color: var(--kinh);
}

.nut-cong-cu {
  flex-grow: 1;
  flex-basis: 0;
  height: 48px;
  border-radius: 18px;
  font-size: 12px;
  white-space: normal;
}

.nut-cong-cu:active,
.nut-cong-cu--bat {
  background-color: var(--nhan);
  color: var(--chu-tren-nhan);
}

.nut-cong-cu:disabled {
  opacity: 0.35;
}

.lop-tam-dung {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 0 24px;
  justify-content: center;
  background-color: var(--nen);
}

.the-tam-dung > .tieu-de-nho {
  margin-bottom: 8px;
}

.ghi-chu {
  margin-top: 8px;
  align-self: center;
  color: var(--chu-phu);
  font-size: 12px;
}
